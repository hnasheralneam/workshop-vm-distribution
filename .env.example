PROXMOX_URL = "10.0.0.150:8006" # port defaults to 8006 if not specified
PROXMOX_USER = "root@pam"
PROXMOX_TOKEN_NAME = "guac-provisioner"
PROXMOX_TOKEN_SECRET = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
PROXMOX_NODE = "proxmox"

GUACAMOLE_URL = "https://guacamole.hnasheralneam.dev/guacamole"
GUACAMOLE_INTERNAL_URL = "http://127.0.0.1:8080/guacamole" # used for minting tokens, to avoid latency when GUACAMOLE_URL goes through a tunnel/proxyS
GUACAMOLE_KEY = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" # matches key configured in guac compose

URL_OUTPUT_FILE = "pool.json"
LOG_FILE = "server.log" # log file (5 MB rotating, 2 backups); relative paths are relative to the repo dir

VERIFY_SSL = false # set to true if your Proxmox has a valid certificate

ADMIN_PASSWORD = "" # protects /admin and /api/admin/*
