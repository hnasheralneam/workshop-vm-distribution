PROXMOX_URL = "10.0.0.150:8006" # [http(s)://]host[:port], defaults to https on 8006 if not specified
PROXMOX_USER = "root@pam"
PROXMOX_TOKEN_NAME = "guac-provisioner"
PROXMOX_TOKEN_SECRET = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
PROXMOX_NODE = "proxmox"

TEMPLATE_VM_ACCESS_METHOD = "ssh" # rdp for windows, vnc for linux desktop
TEMPLATE_VM_ID = 902
TEMPLATE_VM_USERNAME = "example-user"
TEMPLATE_VM_PASSWORD = "example-password"

GUACAMOLE_URL = "http://10.0.0.102:8080/guacamole"
GUACAMOLE_KEY = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" # matches key configured in guac compose
GUAC_LINK_TTL_SECONDS = 7200 # default VM lifetime in seconds before expiry (overridable per-run in the admin UI)
REAP_INTERVAL_SECONDS = 60 # how often the server destroys expired VMs on Proxmox (0 disables auto-removal)

URL_OUTPUT_FILE = "pool.json"
VM_COUNT = 5

LOG_FILE = "server.log" # server/provision/destroy log file (5 MB rotating, 2 backups); relative paths are relative to the repo dir

VERIFY_SSL = false # set to true if your Proxmox has a valid CA-signed certificate

ADMIN_PASSWORD = "" # REQUIRED: set a strong password to protect /admin and /api/admin/* (HTTP Basic Auth)
